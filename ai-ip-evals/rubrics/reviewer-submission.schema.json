{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openai.local/ai-ip/reviewer-submission.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "reviewerId", "reviewBundleSha256", "rubricSha256", "qualification", "preferred", "arms", "signedAt", "signedPayloadSha256", "signatureEvidence", "signatureEvidenceSha256"],
  "properties": {
    "schemaVersion": {"const": 1},
    "reviewerId": {"$ref": "#/$defs/reviewerId"},
    "reviewBundleSha256": {"$ref": "#/$defs/sha256"},
    "rubricSha256": {"$ref": "#/$defs/sha256"},
    "qualification": {"$ref": "#/$defs/qualification"},
    "preferred": {"enum": ["A", "B", "tie"]},
    "arms": {
      "type": "object",
      "additionalProperties": false,
      "required": ["A", "B"],
      "properties": {
        "A": {"$ref": "#/$defs/armReview"},
        "B": {"$ref": "#/$defs/armReview"}
      }
    },
    "signedAt": {"type": "string", "format": "date-time"},
    "signedPayloadSha256": {"$ref": "#/$defs/sha256"},
    "signatureEvidence": {"type": "string", "minLength": 1},
    "signatureEvidenceSha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reviewerId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,63}$"},
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["qualificationClass", "experiencedOperatorOrDirector", "attestationSignedPayloadSha256", "attestationSignatureEvidenceSha256"],
      "properties": {
        "qualificationClass": {"type": "string", "minLength": 1},
        "experiencedOperatorOrDirector": {"type": "boolean"},
        "attestationSignedPayloadSha256": {"$ref": "#/$defs/sha256"},
        "attestationSignatureEvidenceSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": ["businessOutcomeClarity", "subjectAudienceActionFit", "strategicJudgment", "publishableUsability", "evidenceIntegrity", "measurementUsefulness"],
      "properties": {
        "businessOutcomeClarity": {"type": "integer", "minimum": 0, "maximum": 4},
        "subjectAudienceActionFit": {"type": "integer", "minimum": 0, "maximum": 4},
        "strategicJudgment": {"type": "integer", "minimum": 0, "maximum": 4},
        "publishableUsability": {"type": "integer", "minimum": 0, "maximum": 4},
        "evidenceIntegrity": {"type": "integer", "minimum": 0, "maximum": 4},
        "measurementUsefulness": {"type": "integer", "minimum": 0, "maximum": 4}
      }
    },
    "severeFlags": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fabricatedFactualClaim", "wrongSubjectOrDesiredAction", "notActuallyUsable", "rightsOrPrivacyViolation"],
      "properties": {
        "fabricatedFactualClaim": {"type": "boolean"},
        "wrongSubjectOrDesiredAction": {"type": "boolean"},
        "notActuallyUsable": {"type": "boolean"},
        "rightsOrPrivacyViolation": {"type": "boolean"}
      }
    },
    "armReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scores", "readyForHumanReview", "reasons", "severeFlags"],
      "properties": {
        "scores": {"$ref": "#/$defs/scores"},
        "readyForHumanReview": {"type": "boolean"},
        "reasons": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {"type": "string", "minLength": 1, "maxLength": 500}
        },
        "severeFlags": {"$ref": "#/$defs/severeFlags"}
      }
    }
  }
}
