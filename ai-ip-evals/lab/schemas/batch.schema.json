{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "batch.schema.json",
  "title": "BatchContracts",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "objectKind"],
  "properties": {
    "schemaVersion": {"const": 1},
    "objectKind": {"enum": ["EvaluationBatch", "BlindStatistics", "BatchDecision"]},
    "batchId": {"type": "string", "minLength": 1},
    "caseId": {"type": "string", "minLength": 1},
    "rubricSha256": {"$ref": "#/$defs/sha256"},
    "armOutputSha256s": {"type": "array", "items": {"$ref": "#/$defs/sha256"}, "minItems": 2, "uniqueItems": true},
    "reviewerIds": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 2, "uniqueItems": true},
    "analysisFrozenAt": {"type": "string", "format": "date-time"},
    "diagnosticOnly": {"const": true},
    "reviewCount": {"type": "integer", "minimum": 0},
    "qualifiedReviewerCount": {"type": "integer", "minimum": 0},
    "swapConsistentCount": {"type": "integer", "minimum": 0},
    "preferenceCounts": {"type": "object", "additionalProperties": false, "required": ["A", "B", "nearTie", "abstain"], "properties": {"A": {"type": "integer", "minimum": 0}, "B": {"type": "integer", "minimum": 0}, "nearTie": {"type": "integer", "minimum": 0}, "abstain": {"type": "integer", "minimum": 0}}},
    "severeByOutputSha256": {"type": "object", "propertyNames": {"pattern": "^[0-9a-f]{64}$"}, "additionalProperties": {"type": "array", "uniqueItems": true, "items": {"enum": ["fabricatedExistingExperience", "wrongBusinessSubject", "wrongDesiredAction", "singlePathPresentedAsProvenTruth", "notActuallyUsable", "rightsOrPrivacyViolation"]}}},
    "arbitrationRequired": {"type": "boolean"},
    "arbitrationCompleted": {"type": "boolean"},
    "sealedAt": {"type": "string", "format": "date-time"},
    "stockOutputSha256": {"$ref": "#/$defs/sha256"},
    "modifiedOutputSha256": {"$ref": "#/$defs/sha256"},
    "disposition": {"enum": ["fixtureValid", "iterate", "invalid"]},
    "providerMode": {"const": "not-run"},
    "promotionEligible": {"const": false},
    "blindStatisticsSha256": {"$ref": "#/$defs/sha256"},
    "outcomePacketSha256": {"$ref": "#/$defs/sha256"},
    "unlockedAt": {"type": "string", "format": "date-time"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
  "oneOf": [
    {"properties": {"objectKind": {"const": "EvaluationBatch"}}, "propertyNames": {"enum": ["schemaVersion", "objectKind", "batchId", "caseId", "rubricSha256", "armOutputSha256s", "reviewerIds", "analysisFrozenAt", "diagnosticOnly"]}, "required": ["batchId", "caseId", "rubricSha256", "armOutputSha256s", "reviewerIds", "analysisFrozenAt", "diagnosticOnly"]},
    {"properties": {"objectKind": {"const": "BlindStatistics"}}, "propertyNames": {"enum": ["schemaVersion", "objectKind", "batchId", "reviewCount", "qualifiedReviewerCount", "swapConsistentCount", "preferenceCounts", "severeByOutputSha256", "arbitrationRequired", "arbitrationCompleted", "sealedAt"]}, "required": ["batchId", "reviewCount", "qualifiedReviewerCount", "swapConsistentCount", "preferenceCounts", "severeByOutputSha256", "arbitrationRequired", "arbitrationCompleted", "sealedAt"]},
    {"properties": {"objectKind": {"const": "BatchDecision"}}, "propertyNames": {"enum": ["schemaVersion", "objectKind", "batchId", "stockOutputSha256", "modifiedOutputSha256", "disposition", "diagnosticOnly", "providerMode", "promotionEligible", "blindStatisticsSha256", "outcomePacketSha256", "unlockedAt"]}, "required": ["batchId", "stockOutputSha256", "modifiedOutputSha256", "disposition", "diagnosticOnly", "providerMode", "promotionEligible", "blindStatisticsSha256", "outcomePacketSha256", "unlockedAt"]}
  ]
}
