{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "paired-run-receipt.schema.json",
  "title": "PairedRunReceipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "pairId", "planSha256", "stockArmAttemptReceiptSha256", "modifiedArmAttemptReceiptSha256", "conditionParitySha256", "orderRandomizationCommitment", "pairValidity", "invalidReason", "receiptSha256"],
  "properties": {
    "schemaVersion": {"const": 1}, "pairId": {"type": "string", "minLength": 1}, "planSha256": {"$ref": "#/$defs/sha256"}, "stockArmAttemptReceiptSha256": {"$ref": "#/$defs/sha256"}, "modifiedArmAttemptReceiptSha256": {"$ref": "#/$defs/sha256"}, "conditionParitySha256": {"$ref": "#/$defs/sha256"}, "orderRandomizationCommitment": {"$ref": "#/$defs/sha256"}, "pairValidity": {"enum": ["valid", "invalid"]}, "invalidReason": {"type": ["string", "null"]}, "outputRelation": {"enum": ["distinct", "canonicallyIdentical"]}, "anonymousMappingCommitment": {"$ref": "#/$defs/sha256"}, "receiptSha256": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [
    {"if": {"properties": {"pairValidity": {"const": "valid"}}}, "then": {"required": ["outputRelation"], "properties": {"invalidReason": {"type": "null"}}}, "else": {"not": {"anyOf": [{"required": ["outputRelation"]}, {"required": ["anonymousMappingCommitment"]}]}, "properties": {"invalidReason": {"type": "string", "minLength": 1}}}},
    {"if": {"properties": {"outputRelation": {"const": "distinct"}}, "required": ["outputRelation"]}, "then": {"required": ["anonymousMappingCommitment"]}, "else": {"not": {"required": ["anonymousMappingCommitment"]}}}
  ],
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
