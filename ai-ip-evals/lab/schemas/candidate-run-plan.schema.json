{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "candidate-run-plan.schema.json",
  "title": "CandidateRunPlan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "planId", "batchId", "batchKind", "caseBundleId", "caseBundleSha256", "caseAnswerSchemaId", "caseAnswerSchemaSha256", "stockTreatmentRef", "modifiedTreatmentRef", "modelRouteRef", "executionProfileRef", "workspaceTemplateSha256", "promptfooPackageVersion", "promptfooLockSha256", "replicationCount", "retryPolicy", "timeoutBudget", "tokenBudget", "requestBudget", "costBudgetCny", "networkPolicy", "permissionPolicy", "toolPolicy", "createdAt", "sealedAt", "planSha256"],
  "properties": {
    "schemaVersion": {"const": 1}, "planId": {"type": "string", "minLength": 1}, "batchId": {"type": "string", "minLength": 1}, "batchKind": {"enum": ["smoke", "development_blind", "diagnostic"]}, "caseBundleId": {"type": "string", "minLength": 1}, "caseBundleSha256": {"$ref": "#/$defs/sha256"}, "caseAnswerSchemaId": {"type": "string", "minLength": 1}, "caseAnswerSchemaSha256": {"$ref": "#/$defs/sha256"}, "stockTreatmentRef": {"type": "string", "minLength": 1}, "modifiedTreatmentRef": {"type": "string", "minLength": 1}, "modelRouteRef": {"type": "string", "minLength": 1}, "executionProfileRef": {"type": "string", "minLength": 1}, "workspaceTemplateSha256": {"$ref": "#/$defs/sha256"}, "promptfooPackageVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}, "promptfooLockSha256": {"$ref": "#/$defs/sha256"}, "replicationCount": {"type": "integer", "minimum": 1}, "retryPolicy": {"type": "object", "additionalProperties": false, "required": ["maxRetries"], "properties": {"maxRetries": {"type": "integer", "minimum": 0}}}, "timeoutBudget": {"type": "integer", "minimum": 1}, "tokenBudget": {"type": "integer", "minimum": 1}, "requestBudget": {"type": "integer", "minimum": 1}, "costBudgetCny": {"type": "integer", "minimum": 0}, "networkPolicy": {"type": "string", "minLength": 1}, "permissionPolicy": {"type": "string", "minLength": 1}, "toolPolicy": {"type": "string", "minLength": 1}, "createdAt": {"$ref": "#/$defs/timestamp"}, "sealedAt": {"$ref": "#/$defs/timestamp"}, "planSha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "timestamp": {"type": "string", "format": "date-time"}}
}
