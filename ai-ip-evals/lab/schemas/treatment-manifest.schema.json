{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "treatment-manifest.schema.json",
  "title": "TreatmentManifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "treatmentId", "binaryManifestRef", "codexHomeSeedSha256", "systemInstructionSha256", "capabilityBundleSha256", "effectiveCodexConfigSha256", "declaredCapabilities", "prohibitedCaseSpecificMaterial", "treatmentManifestSha256"],
  "properties": {
    "schemaVersion": {"const": 1},
    "treatmentId": {"type": "string", "minLength": 1},
    "binaryManifestRef": {"type": "string", "minLength": 1},
    "codexHomeSeedSha256": {"$ref": "#/$defs/sha256"},
    "systemInstructionSha256": {"$ref": "#/$defs/sha256"},
    "capabilityBundleSha256": {"$ref": "#/$defs/sha256"},
    "effectiveCodexConfigSha256": {"$ref": "#/$defs/sha256"},
    "declaredCapabilities": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "prohibitedCaseSpecificMaterial": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "treatmentManifestSha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
