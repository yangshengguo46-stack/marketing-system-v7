{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openai.local/ai-ip/verification.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "verificationKind",
    "frozenRunContextSha256",
    "subjectSha256",
    "nextIndexSha256",
    "publicRunId",
    "verifierBinarySha256",
    "verifiedAt",
    "valid"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "verificationKind": {"enum": ["report", "liveProof"]},
    "frozenRunContextSha256": {"$ref": "#/$defs/sha256"},
    "subjectSha256": {"$ref": "#/$defs/sha256"},
    "nextIndexSha256": {"$ref": "#/$defs/nullableSha256"},
    "publicRunId": {"$ref": "#/$defs/sha256"},
    "verifierBinarySha256": {"$ref": "#/$defs/sha256"},
    "verifiedAt": {"type": "string", "format": "date-time"},
    "valid": {"const": true}
  },
  "allOf": [
    {
      "if": {"properties": {"verificationKind": {"const": "report"}}},
      "then": {"properties": {"nextIndexSha256": {"type": "string"}}},
      "else": {"properties": {"nextIndexSha256": {"type": "null"}}}
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullableSha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
  }
}
