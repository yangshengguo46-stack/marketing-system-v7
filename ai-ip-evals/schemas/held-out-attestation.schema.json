{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openai.local/ai-ip/held-out-attestation.schema.json",
  "oneOf": [
    {"$ref": "#/$defs/nativeAttestation"},
    {"$ref": "#/$defs/replayAttestation"}
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reviewerId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,63}$"},
    "reviewerDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewerId", "qualificationClass", "experiencedOperatorOrDirector", "declaredAt", "signedPayloadSha256", "signatureEvidence", "signatureEvidenceSha256"],
      "properties": {
        "reviewerId": {"$ref": "#/$defs/reviewerId"},
        "qualificationClass": {"type": "string", "minLength": 1},
        "experiencedOperatorOrDirector": {"type": "boolean"},
        "declaredAt": {"type": "string", "format": "date-time"},
        "signedPayloadSha256": {"$ref": "#/$defs/sha256"},
        "signatureEvidence": {"type": "string", "minLength": 1},
        "signatureEvidenceSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "reviewers": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/reviewerDeclaration"}
    },
    "nativeAttestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "executionMode", "providerMode", "candidateSha", "candidateFrozenAt", "caseSelectedAt", "caseSha256", "sourceMaterialsSha256", "privateRoot", "caseClass", "notOneOfFiveFrozenClasses", "materialAuthorizationScope", "providerDisclosure", "providerRole", "targetProviderModelEvidenceCommitment", "reviewers", "approvalId", "approvedTotalFen", "approvedPerRunFen", "maxProviderRequestAttemptsPerRun", "maxTotalTokensPerRun", "maxElapsedSecondsPerRun", "maxOutputTokensPerRequest", "signedAt", "retentionDeadline", "providerBudgetEvidenceSha256", "rateCardSha256", "billingPolicyCommitment", "fxPolicySha256", "rateCurrency", "rateEffectiveAt"],
      "properties": {
        "schemaVersion": {"const": 1},
        "executionMode": {"const": "live"},
        "providerMode": {"const": "not-run"},
        "candidateSha": {"type": "string", "minLength": 1},
        "candidateFrozenAt": {"type": "string", "format": "date-time"},
        "caseSelectedAt": {"type": "string", "format": "date-time"},
        "caseSha256": {"$ref": "#/$defs/sha256"},
        "sourceMaterialsSha256": {"$ref": "#/$defs/sha256"},
        "privateRoot": {"type": "string", "minLength": 1},
        "caseClass": {"type": "string", "minLength": 1},
        "notOneOfFiveFrozenClasses": {"const": true},
        "materialAuthorizationScope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "providerDisclosure": {"type": "string", "minLength": 1},
        "providerRole": {"enum": ["targetVolcengine", "approvedReference"]},
        "targetProviderModelEvidenceCommitment": {"$ref": "#/$defs/sha256"},
        "reviewers": {"$ref": "#/$defs/reviewers"},
        "approvalId": {"type": "string", "minLength": 1},
        "approvedTotalFen": {"type": "integer", "minimum": 0},
        "approvedPerRunFen": {"type": "integer", "minimum": 0},
        "maxProviderRequestAttemptsPerRun": {"type": "integer", "minimum": 1},
        "maxTotalTokensPerRun": {"type": "integer", "minimum": 1},
        "maxElapsedSecondsPerRun": {"type": "integer", "minimum": 1},
        "maxOutputTokensPerRequest": {"type": "integer", "minimum": 1},
        "signedAt": {"type": "string", "format": "date-time"},
        "retentionDeadline": {"type": "string", "format": "date-time"},
        "providerBudgetEvidenceSha256": {"$ref": "#/$defs/sha256"},
        "rateCardSha256": {"$ref": "#/$defs/sha256"},
        "billingPolicyCommitment": {"$ref": "#/$defs/sha256"},
        "fxPolicySha256": {"$ref": "#/$defs/sha256"},
        "rateCurrency": {"type": "string", "pattern": "^[A-Z]{3}$"},
        "rateEffectiveAt": {"type": "string", "format": "date-time"}
      }
    },
    "replayAttestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "executionMode", "providerMode", "paidProviderCostFen", "syntheticOnly", "pairId", "caseSha256", "sourceMaterialsSha256", "reviewers", "signedAt"],
      "properties": {
        "schemaVersion": {"const": 1},
        "executionMode": {"const": "replay"},
        "providerMode": {"const": "not-run"},
        "paidProviderCostFen": {"const": 0},
        "syntheticOnly": {"const": true},
        "pairId": {"$ref": "#/$defs/sha256"},
        "caseSha256": {"$ref": "#/$defs/sha256"},
        "sourceMaterialsSha256": {"$ref": "#/$defs/sha256"},
        "reviewers": {"$ref": "#/$defs/reviewers"},
        "signedAt": {"type": "string", "format": "date-time"}
      }
    }
  }
}
