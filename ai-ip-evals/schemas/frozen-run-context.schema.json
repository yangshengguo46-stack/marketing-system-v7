{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openai.local/ai-ip/frozen-run-context.schema.json",
  "oneOf": [
    {"$ref": "#/$defs/nativeContext"},
    {"$ref": "#/$defs/replayContext"}
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifactReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "nativeArtifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "attestation", "materials", "codexBinary", "evaluatorBinary", "brokerSource", "schema", "prompt", "additionalContext", "skill", "threadStartRequest", "turnStartRequest", "providerBudgetEvidence", "rateCard", "billingPolicy", "fxPolicy"],
      "properties": {
        "source": {"$ref": "#/$defs/artifactReference"},
        "attestation": {"$ref": "#/$defs/artifactReference"},
        "materials": {"$ref": "#/$defs/artifactReference"},
        "codexBinary": {"$ref": "#/$defs/artifactReference"},
        "evaluatorBinary": {"$ref": "#/$defs/artifactReference"},
        "brokerSource": {"$ref": "#/$defs/artifactReference"},
        "schema": {"$ref": "#/$defs/artifactReference"},
        "prompt": {"$ref": "#/$defs/artifactReference"},
        "additionalContext": {"$ref": "#/$defs/artifactReference"},
        "skill": {"$ref": "#/$defs/artifactReference"},
        "threadStartRequest": {"$ref": "#/$defs/artifactReference"},
        "turnStartRequest": {"$ref": "#/$defs/artifactReference"},
        "providerBudgetEvidence": {"$ref": "#/$defs/artifactReference"},
        "rateCard": {"$ref": "#/$defs/artifactReference"},
        "billingPolicy": {"$ref": "#/$defs/artifactReference"},
        "fxPolicy": {"$ref": "#/$defs/artifactReference"}
      },
      "patternProperties": {
        "^material:[A-Za-z0-9._-]+$": {"$ref": "#/$defs/artifactReference"}
      }
    },
    "nativeContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "executionMode", "providerMode", "pairId", "publicRunId", "candidateSha", "privateRoot", "repoRoot", "repoHead", "providerUpstreamUrl", "modelLabel", "maxOutputTokens", "maxAttemptsPerArm", "maxTotalTokens", "maxElapsedSeconds", "supplierStatementPolicy", "artifacts"],
      "properties": {
        "schemaVersion": {"const": 1},
        "executionMode": {"const": "live"},
        "providerMode": {"const": "not-run"},
        "pairId": {"$ref": "#/$defs/sha256"},
        "publicRunId": {"$ref": "#/$defs/sha256"},
        "candidateSha": {"type": "string", "minLength": 1},
        "privateRoot": {"type": "string", "minLength": 1},
        "repoRoot": {"type": "string", "minLength": 1},
        "repoHead": {"type": "string", "minLength": 1},
        "providerUpstreamUrl": {"type": "string", "format": "uri"},
        "modelLabel": {"type": "string", "minLength": 1},
        "maxOutputTokens": {"type": "integer", "minimum": 1},
        "maxAttemptsPerArm": {"type": "integer", "minimum": 1},
        "maxTotalTokens": {"type": "integer", "minimum": 1},
        "maxElapsedSeconds": {"type": "integer", "minimum": 1},
        "supplierStatementPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["directory", "allowedLeaves", "nestedEntriesAllowed"],
          "properties": {
            "directory": {"const": "inputs/supplier-statements"},
            "allowedLeaves": {
              "type": "array",
              "prefixItems": [
                {"const": "generic.json"},
                {"const": "candidate.json"}
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            },
            "nestedEntriesAllowed": {"const": false}
          }
        },
        "artifacts": {"$ref": "#/$defs/nativeArtifacts"}
      }
    },
    "replayFixtures": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case", "genericRequest", "candidateRequest", "genericTranscript", "candidateTranscript", "leadSkill", "attestation"],
      "properties": {
        "case": {"$ref": "#/$defs/artifactReference"},
        "genericRequest": {"$ref": "#/$defs/artifactReference"},
        "candidateRequest": {"$ref": "#/$defs/artifactReference"},
        "genericTranscript": {"$ref": "#/$defs/artifactReference"},
        "candidateTranscript": {"$ref": "#/$defs/artifactReference"},
        "leadSkill": {"$ref": "#/$defs/artifactReference"},
        "attestation": {"$ref": "#/$defs/artifactReference"}
      }
    },
    "replayContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "executionMode", "providerMode", "pairId", "repoRoot", "forkSha", "privateRoot", "codexBinary", "evaluatorBinary", "fixtureSetManifest", "fixtures"],
      "properties": {
        "schemaVersion": {"const": 1},
        "executionMode": {"const": "replay"},
        "providerMode": {"const": "not-run"},
        "pairId": {"$ref": "#/$defs/sha256"},
        "repoRoot": {"type": "string", "minLength": 1},
        "forkSha": {"type": "string", "minLength": 1},
        "privateRoot": {"type": "string", "minLength": 1},
        "codexBinary": {"$ref": "#/$defs/artifactReference"},
        "evaluatorBinary": {"$ref": "#/$defs/artifactReference"},
        "fixtureSetManifest": {"$ref": "#/$defs/artifactReference"},
        "fixtures": {"$ref": "#/$defs/replayFixtures"}
      }
    }
  }
}
