{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openai.local/ai-ip/business-report.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "publicRunId",
    "decision",
    "forkSha",
    "codexBinarySha256",
    "evaluatorBinarySha256",
    "brokerComponentSha256",
    "modelLabel",
    "providerLabel",
    "providerCompatibilityName",
    "providerRole",
    "frozenRunContextCommitment",
    "executionContextCommitment",
    "attemptIndexRootCommitment",
    "providerEndpointCommitment",
    "privateCaseCommitment",
    "privateMaterialsCommitment",
    "sharedConfigSha256",
    "promptSha256",
    "additionalContextCommitment",
    "outputSchemaSha256",
    "normalizedThreadStartSha256",
    "normalizedTurnStartCommitment",
    "genericCatalogSha256",
    "candidateCatalogSha256",
    "candidateSkillUseVerified",
    "skillUseEvidenceCommitment",
    "pairManifestsCommitment",
    "attestationCommitment",
    "armOrderCommitment",
    "rateCardSha256",
    "reviewSubmissionsCommitment",
    "proofRootSha256",
    "rubricSha256",
    "reviewerCount",
    "experiencedOperatorOrDirectorCount",
    "candidatePreferenceCount",
    "candidateReadyForHumanReviewCount",
    "medianGenericScore",
    "medianCandidateScore",
    "medianPairedDelta",
    "candidateSevereFailureCount",
    "genericUsage",
    "candidateUsage",
    "genericCostFen",
    "candidateCostFen",
    "providerRequestAttemptCounts",
    "providerCompletedResponseCounts",
    "usageScope",
    "privateEvidenceRetentionDeadline",
    "capabilityStatus",
    "retentionStatus",
    "sourceMaterialRetention",
    "retentionCloseoutReceiptPath",
    "generatedAt"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "publicRunId": {"$ref": "#/$defs/sha256"},
    "decision": {
      "enum": [
        "BUSINESS_SIGNAL_PASS_PENDING_FOUNDATION",
        "ITERATE_SMALLEST_LEAD_CHANGE",
        "INVALID_PROOF"
      ]
    },
    "forkSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "codexBinarySha256": {"$ref": "#/$defs/sha256"},
    "evaluatorBinarySha256": {"$ref": "#/$defs/sha256"},
    "brokerComponentSha256": {"$ref": "#/$defs/sha256"},
    "modelLabel": {"type": "string", "minLength": 1, "maxLength": 200},
    "providerLabel": {"type": "string", "minLength": 1, "maxLength": 200},
    "providerCompatibilityName": {"const": "OpenAI"},
    "providerRole": {"enum": ["targetVolcengine", "approvedReference"]},
    "frozenRunContextCommitment": {"$ref": "#/$defs/sha256"},
    "executionContextCommitment": {"$ref": "#/$defs/sha256"},
    "attemptIndexRootCommitment": {"$ref": "#/$defs/sha256"},
    "providerEndpointCommitment": {"$ref": "#/$defs/sha256"},
    "privateCaseCommitment": {"$ref": "#/$defs/sha256"},
    "privateMaterialsCommitment": {"$ref": "#/$defs/sha256"},
    "sharedConfigSha256": {"$ref": "#/$defs/sha256"},
    "promptSha256": {"$ref": "#/$defs/sha256"},
    "additionalContextCommitment": {"$ref": "#/$defs/sha256"},
    "outputSchemaSha256": {"$ref": "#/$defs/sha256"},
    "normalizedThreadStartSha256": {"$ref": "#/$defs/sha256"},
    "normalizedTurnStartCommitment": {"$ref": "#/$defs/sha256"},
    "genericCatalogSha256": {"$ref": "#/$defs/sha256"},
    "candidateCatalogSha256": {"$ref": "#/$defs/sha256"},
    "candidateSkillUseVerified": {"type": "boolean"},
    "skillUseEvidenceCommitment": {"$ref": "#/$defs/sha256"},
    "pairManifestsCommitment": {"$ref": "#/$defs/sha256"},
    "attestationCommitment": {"$ref": "#/$defs/sha256"},
    "armOrderCommitment": {"$ref": "#/$defs/sha256"},
    "rateCardSha256": {"$ref": "#/$defs/sha256"},
    "reviewSubmissionsCommitment": {"$ref": "#/$defs/sha256"},
    "proofRootSha256": {"$ref": "#/$defs/sha256"},
    "rubricSha256": {"$ref": "#/$defs/sha256"},
    "reviewerCount": {"const": 3},
    "experiencedOperatorOrDirectorCount": {"type": "integer", "minimum": 0, "maximum": 3},
    "candidatePreferenceCount": {"type": "integer", "minimum": 0, "maximum": 3},
    "candidateReadyForHumanReviewCount": {"type": "integer", "minimum": 0, "maximum": 3},
    "medianGenericScore": {"type": "integer", "minimum": 0, "maximum": 24},
    "medianCandidateScore": {"type": "integer", "minimum": 0, "maximum": 24},
    "medianPairedDelta": {"type": "integer", "minimum": -24, "maximum": 24},
    "candidateSevereFailureCount": {"type": "integer", "minimum": 0, "maximum": 12},
    "genericUsage": {"$ref": "#/$defs/usage"},
    "candidateUsage": {"$ref": "#/$defs/usage"},
    "genericCostFen": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
    "candidateCostFen": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
    "providerRequestAttemptCounts": {"$ref": "#/$defs/pairCounts"},
    "providerCompletedResponseCounts": {"$ref": "#/$defs/pairCounts"},
    "usageScope": {"const": "rootSessionTree"},
    "privateEvidenceRetentionDeadline": {"type": "string", "format": "date-time"},
    "capabilityStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "codePresent",
        "mechanicalContracts",
        "liveProviderReachable",
        "businessBlindReview",
        "publicationRetro"
      ],
      "properties": {
        "codePresent": {"const": true},
        "mechanicalContracts": {"const": "pendingFoundationVerification"},
        "liveProviderReachable": {"type": "boolean"},
        "businessBlindReview": {"enum": ["passed", "iterate", "invalid"]},
        "publicationRetro": {"const": "notRun"}
      }
    },
    "retentionStatus": {"const": "pending"},
    "sourceMaterialRetention": {"const": "userOwnedOriginalsOutsideProofCopyScope"},
    "retentionCloseoutReceiptPath": {"const": "retention-closeout.json"},
    "generatedAt": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"decision": {"const": "BUSINESS_SIGNAL_PASS_PENDING_FOUNDATION"}}},
      "then": {
        "properties": {
          "experiencedOperatorOrDirectorCount": {"minimum": 2},
          "candidatePreferenceCount": {"minimum": 2},
          "candidateReadyForHumanReviewCount": {"minimum": 2},
          "medianCandidateScore": {"minimum": 18},
          "medianPairedDelta": {"minimum": 3},
          "candidateSkillUseVerified": {"const": true},
          "candidateSevereFailureCount": {"const": 0},
          "capabilityStatus": {
            "properties": {
              "liveProviderReachable": {"const": true},
              "businessBlindReview": {"const": "passed"}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"decision": {"const": "ITERATE_SMALLEST_LEAD_CHANGE"}}},
      "then": {
        "properties": {
          "capabilityStatus": {
            "properties": {"businessBlindReview": {"const": "iterate"}}
          }
        }
      }
    },
    {
      "if": {"properties": {"decision": {"const": "INVALID_PROOF"}}},
      "then": {
        "properties": {
          "capabilityStatus": {
            "properties": {"businessBlindReview": {"const": "invalid"}}
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "totalTokens",
        "inputTokens",
        "cachedInputTokens",
        "cacheWriteInputTokens",
        "outputTokens",
        "reasoningOutputTokens"
      ],
      "properties": {
        "totalTokens": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
        "inputTokens": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
        "cachedInputTokens": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
        "cacheWriteInputTokens": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
        "outputTokens": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
        "reasoningOutputTokens": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807}
      }
    },
    "pairCounts": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615}
    }
  }
}
