{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openai.local/ai-ip/attempt-index.schema.json",
  "oneOf": [
    {"$ref": "#/$defs/requestRecord"},
    {"$ref": "#/$defs/terminalRecord"}
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullableSha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "totalTokens",
        "inputTokens",
        "cachedInputTokens",
        "cacheWriteInputTokens",
        "outputTokens",
        "reasoningOutputTokens"
      ],
      "properties": {
        "totalTokens": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
        "inputTokens": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
        "cachedInputTokens": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
        "cacheWriteInputTokens": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
        "outputTokens": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
        "reasoningOutputTokens": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807}
      }
    },
    "nullableUsage": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/usage"}
      ]
    },
    "requestRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "recordType",
        "status",
        "pairId",
        "frozenRunContextSha256",
        "executionContextSha256",
        "globalAttemptIndex",
        "runOrdinal",
        "condition",
        "armAttemptIndex",
        "requestStartedAt",
        "requestCommitment",
        "normalizedRequestCommitment",
        "normalizedBaseCommitment",
        "treatmentDiffCommitment",
        "threadCommitment",
        "windowCommitment",
        "parentThreadCommitment",
        "deadline",
        "maxOutputTokens"
      ],
      "properties": {
        "schemaVersion": {"const": 1},
        "recordType": {"const": "request"},
        "status": {"const": "forwarding"},
        "pairId": {"$ref": "#/$defs/sha256"},
        "frozenRunContextSha256": {"$ref": "#/$defs/sha256"},
        "executionContextSha256": {"$ref": "#/$defs/sha256"},
        "globalAttemptIndex": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
        "runOrdinal": {"type": "integer", "minimum": 1, "maximum": 2},
        "condition": {"enum": ["generic", "candidate"]},
        "armAttemptIndex": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
        "requestStartedAt": {"type": "string", "format": "date-time"},
        "requestCommitment": {"$ref": "#/$defs/sha256"},
        "normalizedRequestCommitment": {"$ref": "#/$defs/sha256"},
        "normalizedBaseCommitment": {"$ref": "#/$defs/sha256"},
        "treatmentDiffCommitment": {"$ref": "#/$defs/nullableSha256"},
        "threadCommitment": {"$ref": "#/$defs/sha256"},
        "windowCommitment": {"$ref": "#/$defs/sha256"},
        "parentThreadCommitment": {"$ref": "#/$defs/nullableSha256"},
        "deadline": {"type": "string", "format": "date-time"},
        "maxOutputTokens": {"type": "integer", "minimum": 1, "maximum": 18446744073709551615}
      },
      "allOf": [
        {
          "if": {"properties": {"condition": {"const": "generic"}}},
          "then": {"properties": {"treatmentDiffCommitment": {"type": "null"}}},
          "else": {"properties": {"treatmentDiffCommitment": {"type": "string"}}}
        }
      ]
    },
    "terminalRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "recordType",
        "globalAttemptIndex",
        "requestRecordSha256",
        "endedAt",
        "status",
        "responseIdCommitment",
        "actualModelRevision",
        "deploymentCommitment",
        "usage",
        "failureClass"
      ],
      "properties": {
        "schemaVersion": {"const": 1},
        "recordType": {"const": "terminal"},
        "globalAttemptIndex": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
        "requestRecordSha256": {"$ref": "#/$defs/sha256"},
        "endedAt": {"type": "string", "format": "date-time"},
        "status": {"enum": ["completed", "failed", "timeout"]},
        "responseIdCommitment": {"$ref": "#/$defs/nullableSha256"},
        "actualModelRevision": {"type": ["string", "null"], "minLength": 1, "maxLength": 200},
        "deploymentCommitment": {"$ref": "#/$defs/nullableSha256"},
        "usage": {"$ref": "#/$defs/nullableUsage"},
        "failureClass": {"type": ["string", "null"], "minLength": 1, "maxLength": 200}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "completed"}}},
          "then": {
            "properties": {
              "responseIdCommitment": {"type": "string"},
              "usage": {"$ref": "#/$defs/usage"},
              "failureClass": {"type": "null"}
            }
          },
          "else": {"properties": {"failureClass": {"type": "string"}}}
        }
      ]
    }
  }
}
