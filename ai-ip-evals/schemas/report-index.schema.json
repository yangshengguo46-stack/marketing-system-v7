{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openai.local/ai-ip/report-index.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "attempts"],
  "properties": {
    "schemaVersion": {"const": 1},
    "attempts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "contains": {
        "type": "object",
        "required": ["selected"],
        "properties": {"selected": {"const": true}}
      },
      "minContains": 0,
      "maxContains": 1,
      "items": {"$ref": "#/$defs/attempt"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publicRunId",
        "reportPath",
        "reportSha256",
        "decision",
        "selected",
        "generatedAt"
      ],
      "properties": {
        "publicRunId": {"$ref": "#/$defs/sha256"},
        "reportPath": {
          "type": "string",
          "pattern": "^docs/evidence/business-proof/[0-9a-f]{64}/report\\.json$"
        },
        "reportSha256": {"$ref": "#/$defs/sha256"},
        "decision": {
          "enum": [
            "BUSINESS_SIGNAL_PASS_PENDING_FOUNDATION",
            "ITERATE_SMALLEST_LEAD_CHANGE",
            "INVALID_PROOF"
          ]
        },
        "selected": {"type": "boolean"},
        "generatedAt": {"type": "string", "format": "date-time"}
      }
    }
  }
}
