{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openai.local/ai-ip/retention-closeout.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "pairCommitment",
    "reportCommitment",
    "proofRootSha256",
    "inventoryCommitment",
    "scheduledAt",
    "deletedAt",
    "status",
    "operator",
    "proofCopiesDeleted",
    "externalUserSourcesRetained",
    "method",
    "physicalSecureErasureGuaranteed",
    "failureReasons"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "pairCommitment": {"$ref": "#/$defs/sha256"},
    "reportCommitment": {"$ref": "#/$defs/sha256"},
    "proofRootSha256": {"$ref": "#/$defs/sha256"},
    "inventoryCommitment": {"$ref": "#/$defs/sha256"},
    "scheduledAt": {"type": "string", "format": "date-time"},
    "deletedAt": {"type": ["string", "null"], "format": "date-time"},
    "status": {"enum": ["succeeded", "failed"]},
    "operator": {"type": "string", "minLength": 1, "maxLength": 200},
    "proofCopiesDeleted": {"type": "boolean"},
    "externalUserSourcesRetained": {"const": true},
    "method": {"const": "logical-filesystem-delete"},
    "physicalSecureErasureGuaranteed": {"const": false},
    "failureReasons": {
      "type": "array",
      "maxItems": 16,
      "items": {"type": "string", "minLength": 1, "maxLength": 500}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "succeeded"}}},
      "then": {
        "properties": {
          "deletedAt": {"type": "string"},
          "proofCopiesDeleted": {"const": true},
          "failureReasons": {"maxItems": 0}
        }
      },
      "else": {
        "properties": {
          "deletedAt": {"type": "null"},
          "proofCopiesDeleted": {"const": false},
          "failureReasons": {"minItems": 1}
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
